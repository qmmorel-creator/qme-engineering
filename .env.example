# Variables Netlify du site QME (netlify/functions/contact.mts).
# Ne jamais commiter de vraies valeurs — ce fichier ne sert que de squelette.
# Détail complet du contrat et du modèle de menace :
# https://github.com/qmmorel-creator/nexora/blob/main/docs/qme-intake/CONTRAT.md

# Secret HMAC partagé avec l'endpoint Nexora — MÊME valeur que
# QME_INTAKE_SIGNING_KEY côté nexora-project. Jamais exposé au navigateur.
QME_INTAKE_SIGNING_KEY=

# URL de l'endpoint d'ingestion Nexora (publique, pas un secret).
NEXORA_INTAKE_URL=https://nexora-project.org/api/nexora/qme-intake
